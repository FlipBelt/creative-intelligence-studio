{
  "name": "creative-intelligence-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.15.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev apps/web --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/run-next.mjs build apps/web && node scripts/stage-export.mjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --experimental-strip-types --test apps/web/lib/workflow.test.ts apps/web/lib/studio.test.ts",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "test:cloud-checks": "node --test scripts/cloud-checks.test.mjs",
    "test:mock": "node --test tests/mock-mcp/*.test.mjs",
    "mock:stdio": "node tools/mock-mcp/stdio.mjs",
    "check:cloud": "npm run check:toolchain && npm run check:preview && npm run test:cloud-checks && npm run typecheck && npm test && npm run test:mock && npm run test:pilot-input && npm run build",
    "test:pilot-input": "node --test tests/pilot-input/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
